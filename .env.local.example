# Supabase — Connection Pooler (app + Vercel)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Supabase — Direct connection (for migrations via npm run db:migrate)
DATABASE_URL_DIRECT=postgresql://postgres:[URL_ENCODED_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# AI — Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# AI — OpenAI GPT
OPENAI_API_KEY=sk-...

# Base URL (used by /api/scan to call /api/stocks internally)
# Leave blank for local dev — it defaults to http://localhost:3000
# On Vercel this is set automatically via VERCEL_URL
NEXT_PUBLIC_BASE_URL=https://timandshanestock.com
